# Neon pooled URL only (hostname must include -pooler). Never the direct/unpooled host.
# Example: postgresql://USER:PASS@ep-xxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=""

# Public origin, no trailing slash. Production: https://YOUR_VERCEL_DOMAIN
# Used for share links, data-deletion status URLs, and as Instagram redirect fallback.
APP_URL="http://localhost:3000"

# Meta App Dashboard → App ID
# Instagram product → Business Login for Instagram
INSTAGRAM_APP_ID=""

# Meta App Dashboard → App Secret
INSTAGRAM_APP_SECRET=""

# Exact Valid OAuth Redirect URI in Meta. Production:
# https://YOUR_VERCEL_DOMAIN/api/auth/instagram/callback
INSTAGRAM_REDIRECT_URI="http://localhost:3000/api/auth/instagram/callback"

# 64 hex chars (32 bytes). openssl rand -hex 32
# Encrypts Instagram access tokens at rest.
TOKEN_ENCRYPTION_KEY=""

# 32+ chars. Signs the session cookie. openssl rand -hex 32
SESSION_SECRET=""

# Bearer secret for POST /api/sync bulk refresh (cron).
CRON_SECRET=""
